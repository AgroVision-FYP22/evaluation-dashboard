# Connect to the deployed backend's eval endpoint
REACT_APP_EVAL_API_URL=
# The static secure string you set in the backend environment variables
REACT_APP_EVAL_API_KEY=your_secure_password
ALLOWED_HOSTS=localhost,127.0.0.1
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Or comment out the above variables to fall back to the local agentic-engine proxy
